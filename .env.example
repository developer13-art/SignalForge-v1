# =============================================================
# SignalForge AI - Environment Configuration Example
# =============================================================
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to source control.
# =============================================================

# -------------------------------------------------------------
# Application
# -------------------------------------------------------------
NODE_ENV=development
APP_NAME=SignalForge
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
APP_PORT=4000
APP_TIMEZONE=UTC
APP_LOCALE=en

# -------------------------------------------------------------
# Security
# -------------------------------------------------------------
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=signalforge
JWT_AUDIENCE=signalforge-api

SESSION_SECRET=
COOKIE_SECRET=
ENCRYPTION_KEY=
ENCRYPTION_IV_LENGTH=16
HASH_SALT_ROUNDS=12

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# -------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signalforge
DB_USER=signalforge
DB_PASSWORD=
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# -------------------------------------------------------------
# Mail (SMTP)
# -------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@signalforge.ai
MAIL_FROM_NAME=SignalForge

# -------------------------------------------------------------
# SMS
# -------------------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -------------------------------------------------------------
# Push Notifications
# -------------------------------------------------------------
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# -------------------------------------------------------------
# Object Storage (S3-compatible)
# -------------------------------------------------------------
STORAGE_DRIVER=s3
STORAGE_BUCKET=signalforge-private
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL=900

# -------------------------------------------------------------
# AI / LLM
# -------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-pro

LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=30000
LLM_RETRY_ATTEMPTS=3

# -------------------------------------------------------------
# MetaApi (Broker Gateway)
# -------------------------------------------------------------
METAAPI_TOKEN=
METAAPI_BASE_URL=https://mt-client-api-v1.new-york.agiliumtrade.ai
METAAPI_PROVISIONING_URL=https://mt-provisioning-api-v1.agiliumtrade.ai
METAAPI_WS_URL=wss://mt-client-api-v1.new-york.agiliumtrade.ai
METAAPI_RETRY_ATTEMPTS=3
METAAPI_RETRY_DELAY_MS=2000

# -------------------------------------------------------------
# Telegram (User Session)
# -------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=

# -------------------------------------------------------------
# Discord
# -------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:4000/api/sources/discord/callback

# -------------------------------------------------------------
# WhatsApp (Cloud API)
# -------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# -------------------------------------------------------------
# TradingView
# -------------------------------------------------------------
TRADINGVIEW_WEBHOOK_SECRET=

# -------------------------------------------------------------
# Email Inbound (IMAP)
# -------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# -------------------------------------------------------------
# Payments - Stripe
# -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/subscriptions/success
STRIPE_CANCEL_URL=http://localhost:3000/subscriptions/cancel

# -------------------------------------------------------------
# Payments - Paystack
# -------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=http://localhost:3000/subscriptions/success

# -------------------------------------------------------------
# Payments - Flutterwave
# -------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# -------------------------------------------------------------
# KYC - Smile ID
# -------------------------------------------------------------
SMILEID_PARTNER_ID=
SMILEID_API_KEY=
SMILEID_BASE_URL=https://api.smileidentity.com/v1
SMILEID_CALLBACK_URL=http://localhost:4000/api/webhooks/kyc/smileid

# -------------------------------------------------------------
# KYC - VerifyMe
# -------------------------------------------------------------
VERIFYME_CLIENT_ID=
VERIFYME_CLIENT_SECRET=
VERIFYME_BASE_URL=https://vapi.verifyme.ng/v1
VERIFYME_CALLBACK_URL=http://localhost:4000/api/webhooks/kyc/verifyme

# -------------------------------------------------------------
# Solana
# -------------------------------------------------------------
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
SOLANA_ATTESTATION_PROGRAM_ID=
SOLANA_PROVENANCE_PROGRAM_ID=
SOLANA_PAYMENT_PROGRAM_ID=
SOLANA_TREASURY_WALLET=
SOLANA_ADMIN_KEYPAIR_PATH=
SOLANA_PAYMENT_TOKEN_MINT=
SOLANA_CONFIRMATION_TIMEOUT_MS=60000
SOLANA_RETRY_ATTEMPTS=3

# -------------------------------------------------------------
# White Label
# -------------------------------------------------------------
WHITE_LABEL_ENABLED=false
WHITE_LABEL_ROOT_DOMAIN=signalforge.ai
WHITE_LABEL_DNS_PROVIDER=cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# -------------------------------------------------------------
# Feature Flags
# -------------------------------------------------------------
FEATURE_SOLANA=true
FEATURE_COPY_TRADING=true
FEATURE_CONSENSUS=true
FEATURE_PROVIDER_CERTIFICATION=true
FEATURE_WHITE_LABEL=false
FEATURE_MARKETPLACE=true
FEATURE_REFERRALS=true

# -------------------------------------------------------------
# Observability
# -------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=logs
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=false
TRACING_ENDPOINT=

# -------------------------------------------------------------
# Business Defaults
# -------------------------------------------------------------
REFERRAL_REWARD_RATE=0.001
REFERRAL_SETTLEMENT_CYCLE=monthly
REFERRAL_MIN_PAYOUT=10
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
SIGNAL_CONFIDENCE_THRESHOLD=0.8
MAX_DAILY_LOSS_DEFAULT=500
MAX_DRAWDOWN_DEFAULT=0.2
MAX_OPEN_TRADES_DEFAULT=10