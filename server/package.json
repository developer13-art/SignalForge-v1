{
  "name": "@signalforge/server",
  "version": "1.0.0",
  "private": true,
  "description": "SignalForge AI backend server",
  "type": "module",
  "main": "./src/index.js",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --config nodemon.json src/index.js",
    "build": "echo \"Server has no build step\"",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --coverage",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js tests/integration",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js tests/e2e",
    "migrate": "node scripts/migrate.js",
    "migrate:rollback": "node scripts/rollback.js",
    "migrate:status": "node scripts/migrate-status.js",
    "create:admin": "node scripts/create-admin.js",
    "create:provider": "node scripts/create-provider.js",
    "seed:permissions": "node scripts/seed-permissions.js",
    "seed:plans": "node scripts/seed-plans.js",
    "generate:api-keys": "node scripts/generate-api-keys.js",
    "verify:solana": "node scripts/verify-solana-program.js",
    "clean": "rm -rf node_modules coverage logs"
  },
  "dependencies": {
    "@signalforge/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "connect-pg-simple": "^9.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.13",
    "pg": "^8.11.5",
    "pg-format": "^1.0.4",
    "pino": "^9.0.0",
    "pino-http": "^10.1.0",
    "pino-pretty": "^11.0.0",
    "socket.io": "^4.7.5",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.91.8",
    "imapflow": "^1.0.161",
    "mailparser": "^3.7.1",
    "metaapi.cloud-sdk": "^27.0.0",
    "node-telegram-bot-api": "^0.66.0",
    "stripe": "^15.8.0",
    "telegram": "^2.22.2",
    "twilio": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  }
}