{
  "name": "@signalforge/server",
  "version": "1.0.0",
  "private": true,
  "description": "SignalForge AI - Express backend",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "dev": "nodemon --config nodemon.json src/index.js",
    "start": "node src/index.js",
    "build": "echo \"No build step for server\"",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPattern=tests/unit",
    "test:integration": "jest --config jest.config.js --testPathPattern=tests/integration",
    "test:e2e": "jest --config jest.config.js --testPathPattern=tests/e2e",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "migrate": "node --experimental-specifier-resolution=node scripts/migrate.js",
    "migrate:rollback": "node --experimental-specifier-resolution=node scripts/rollback.js",
    "migrate:status": "node --experimental-specifier-resolution=node scripts/migrate-status.js",
    "create:admin": "node --experimental-specifier-resolution=node scripts/create-admin.js",
    "create:provider": "node --experimental-specifier-resolution=node scripts/create-provider.js",
    "seed:permissions": "node --experimental-specifier-resolution=node scripts/seed-permissions.js",
    "seed:plans": "node --experimental-specifier-resolution=node scripts/seed-plans.js",
    "clean": "rm -rf node_modules coverage dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@solana/actions-spec": "^1.0.1",
    "@solana/spl-memo": "^0.2.5",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "bs58": "^6.0.0",
    "compression": "^1.7.4",
    "connect-pg-simple": "^9.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.0",
    "google-auth-library": "^9.14.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "metaapi.cloud-sdk": "^27.2.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "openai": "^4.71.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.5.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "socket.io": "^4.8.4",
    "speakeasy": "^2.0.0",
    "stripe": "^17.4.0",
    "telegram": "^2.26.22",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "validator": "^13.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.2.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}