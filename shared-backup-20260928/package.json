{
  "name": "@signalforge/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",

    "./constants": "./src/constants/index.cjs",
    "./constants/crypto-pairs": "./src/constants/crypto-pairs/index.cjs",
    "./constants/crypto-pairs/*": "./src/constants/crypto-pairs/*.cjs",
    "./constants/proof-of-alpha": "./src/constants/proof-of-alpha/index.cjs",
    "./constants/proof-of-alpha/*": "./src/constants/proof-of-alpha/*.cjs",
    "./constants/solana-actions": "./src/constants/solana-actions/index.cjs",
    "./constants/solana-actions/*": "./src/constants/solana-actions/*.cjs",
    "./constants/*": "./src/constants/*.js",

    "./schemas": "./src/schemas/index.cjs",
    "./schemas/actions": "./src/schemas/actions/index.cjs",
    "./schemas/actions/*": "./src/schemas/actions/*.cjs",
    "./schemas/execution-routing": "./src/schemas/execution-routing/index.cjs",
    "./schemas/execution-routing/*": "./src/schemas/execution-routing/*.cjs",
    "./schemas/proof-of-alpha": "./src/schemas/proof-of-alpha/index.cjs",
    "./schemas/proof-of-alpha/*": "./src/schemas/proof-of-alpha/*.cjs",
    "./schemas/*": "./src/schemas/*.js",

    "./types": "./src/types/index.js",
    "./types/*": "./src/types/*.js",

    "./utils": "./src/utils/index.js",
    "./utils/*": "./src/utils/*.js",

    "./validators": "./src/validators/index.js",
    "./validators/*": "./src/validators/*.js"
